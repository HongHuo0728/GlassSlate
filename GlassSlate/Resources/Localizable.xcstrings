    "System follows your iPhone appearance. Home Screen icon appearance is controlled by iOS.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System follows your iPhone appearance. Home Screen icon appearance is controlled by iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“跟随系统”会跟随 iPhone 外观。主屏幕图标外观由 iOS 控制。"
          }
        }
      }
    },
    "After saving a snapshot, numeric Takes advance by one. 009 becomes 010; 02B stays 02B.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After saving a snapshot, numeric Takes advance by one. 009 becomes 010; 02B stays 02B."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存拍板快照后，仅纯数字条次加一。009 变为 010；02B 保持不变。"
          }
        }
      }
    },
    "Follows your device language. To choose English or Simplified Chinese for GlassSlate, open the native App settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follows your device language. To choose English or Simplified Chinese for GlassSlate, open the native App settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认跟随设备语言。要为 GlassSlate 选择英文或简体中文，请打开系统中的 App 设置。"
          }
        }
      }
    },
    "WAV and M4A recommended. Up to 30 seconds and 50 MB. Imported audio is copied onto this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WAV and M4A recommended. Up to 30 seconds and 50 MB. Imported audio is copied onto this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐 WAV、M4A，最长 30 秒、最大 50 MB。导入音效会复制并保存在此设备上。"
          }
        }
      }
    },
    "Use this system control to adjust volume. Check Bluetooth and wired output. Clap playback can sound even in Silent Mode. GlassSlate never changes system volume automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this system control to adjust volume. Check Bluetooth and wired output. Clap playback can sound even in Silent Mode. GlassSlate never changes system volume automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用此系统控件调节音量，并检查蓝牙与有线输出。拍板声可在静音模式下播放。GlassSlate 不会自动修改系统音量。"
          }
        }
      }
    },
    "Your saved data could not be opened. It has not been erased.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved data could not be opened. It has not been erased."
